    "item_1": {
      "type": "score",
      "instructions": "Rate relevance of pages[1] to query.",
      "criteria": [
        "Unrelated",
        "Related background",
        "Direct answer"
      ]
    },
    "item_2": {
      "type": "score",
      "instructions": "Rate relevance of pages[2] to query.",
      "criteria": [
        "Unrelated",
        "Related background",
        "Direct answer"
      ]
    }
  },
  "scenarios": [
