# Add keys locally. Never commit .env or put keys in browser code.
TYPESAFE_API_KEY=
OPENAI_API_KEY=
JEV_MODEL=jev-latest
# Optional: send Jev requests to a proxy, a gateway or a local server that
# speaks /v1/systemone (for example WaterSheep). Defaults to api.typesafe.ai.
# TYPESAFE_BASE_URL=http://127.0.0.1:8766
OPENAI_MODEL=gpt-4o-mini
PORT=3000
# Optional absolute public URL, including a repository subpath, for static SEO output.
# SITE_URL=https://your-domain.example/awesome-jev-use-cases/
